+// ---------------------------------------------------------------------------
+// Per-company Claude-fallback hourly cap
+//
+// When OpenRouter exhausts, ALL hermes agents at a company would otherwise
+// stampede onto Claude in parallel — a real pricing cascade. Track invocations
+// per companyId in an in-memory sliding hour window; refuse fallback once the
+// cap is hit and surface the original carousel failure instead.
+//
+// In-memory is OK: all adapter instances live in the same node process (the
+// Paperclip server). Trade-offs:
+//   - `tsx watch` reload (dev) and full server restart both reset the counter.
+//     Acceptable: hourly granularity means a reset gives you "up to 5 more"
+//     for the next hour, not unlimited burst — and the FALLBACK_USED stdout
+//     marker still appears in run logs so operators can audit post-hoc.
+//   - Map is keyed by companyId and bounded by the company count (typically
+//     <10 in production), so no unbounded growth.
+//   - Cap=0 disables fallback entirely (treated as cap_exceeded immediately).
+// ---------------------------------------------------------------------------
+const CLAUDE_FALLBACK_WINDOW_MS = 60 * 60 * 1000;
+const _claudeFallbackByCompany = new Map(); // companyId -> { count, windowStart }
+
+function _resolveFallbackCap() {
+    const raw = parseInt(process.env.HERMES_FALLBACK_CLAUDE_MAX_PER_HOUR ?? "", 10);
+    if (Number.isFinite(raw) && raw >= 0) return raw;
+    return 5;
+}
+
+function tryConsumeClaudeFallbackBudget(companyId) {
+    const cap = _resolveFallbackCap();
+    if (cap <= 0) return { allowed: false, count: 0, cap, reason: "cap_zero" };
+    const key = companyId || "_unknown";
+    const now = Date.now();
+    let entry = _claudeFallbackByCompany.get(key);
+    if (!entry || now - entry.windowStart >= CLAUDE_FALLBACK_WINDOW_MS) {
+        entry = { count: 0, windowStart: now };
+    }
+    if (entry.count >= cap) {
+        _claudeFallbackByCompany.set(key, entry);
+        return { allowed: false, count: entry.count, cap, reason: "cap_exceeded" };
+    }
+    entry.count += 1;
+    _claudeFallbackByCompany.set(key, entry);
+    return { allowed: true, count: entry.count, cap };
+}
+
+function estimatePromptTokens(prompt) {
+    // Crude — chars/4 is the well-known rough estimate. Operators only need
+    // an order-of-magnitude figure to spot runaway costs in logs.
+    if (!prompt) return 0;
+    return Math.ceil(prompt.length / 4);
+}
