+// Free model ranker — shir-man.com scoring approach
+// ---------------------------------------------------------------------------
+let _rankedFreeModels = null;
+let _rankedFreeModelsAt = 0;
+const MODELS_CACHE_TTL = 5 * 60 * 1000; // 5 minutes
+
+async function getRankedFreeModels() {
+    const now = Date.now();
+    if (_rankedFreeModels && now - _rankedFreeModelsAt < MODELS_CACHE_TTL) return _rankedFreeModels;
+    try {
+        const key = process.env.OPENROUTER_API_KEY || "";
+        const headers = key ? { "Authorization": `Bearer ${key}` } : {};
+        const res = await fetch("https://shir-man.com/api/free-llm/top-models", { headers, signal: AbortSignal.timeout(8000) });
+        if (!res.ok) return [];
+        const data = await res.json();
+        const models = (data.models || [])
+            .filter(m => (m.contextLength || 0) >= 64000)
+            .sort((a, b) => (a.rank || 99) - (b.rank || 99));
+        _rankedFreeModels = models.map(m => m.id);
+        _rankedFreeModelsAt = Date.now();
+        return _rankedFreeModels;
+    } catch {
+        return [];
+    }
+}
+
+function isRateLimitOutput(stdout, stderr) {
+    const combined = (stdout || "") + (stderr || "");
+    return /rate.limit|429|too many requests|free-models-per/i.test(combined);
+}
